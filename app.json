{
  "expo": {
    "name": "project-x",
    "slug": "project-x",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "projectx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "usesAppleSignIn": true,
      "icon": {
        "light": "./core/assets/images/ios-light.png",
        "dark": "./core/assets/images/ios-dark.png",
        "tinted": "./core/assets/images/ios-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.kachielite.project-x"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./core/assets/images/android-icon.png",
        "backgroundImage": "./core/assets/images/android-icon.png",
        "monochromeImage": "./core/assets/images/android-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./core/assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.215586258976-ijel2si86v0r1f8l0792o1pg9rjnl39o"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
